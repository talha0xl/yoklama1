# Bu dosyayı ".env.local" olarak kopyalayın ve kendi Supabase bilgilerinizi girin.
# Vercel'e deploy ederken aynı 3 değeri Project Settings > Environment Variables kısmına ekleyin.

# Supabase Dashboard > Project Settings > API sayfasından alınır
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kendiniz uydurun: en az 20 karakter, rastgele bir metin (oturum çerezini imzalamak için)
SESSION_SECRET=buraya-uzun-rastgele-bir-metin-yazin-12345
